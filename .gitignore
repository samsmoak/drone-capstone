# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
# cflib's TOC cache, keyed by firmware CRC. Machine-local, regenerated on
# connect — and it is drone state, not source.
.cache/

# PyInstaller output — the sidecar is built, never committed.
backend/agent/packaging/build/
backend/agent/packaging/dist/
.mypy_cache/
.ruff_cache/

# ── Node / Next ───────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# ── Rust / Tauri ──────────────────────────────────────────
target/
desktop/src-tauri/target/
desktop/src-tauri/bin/

# ── Secrets ───────────────────────────────────────────────
# The repository is public. .env.team holds every team secret (admin keys
# included) and is named explicitly, so no later change to the patterns
# below can un-ignore it.
.env.team
.env
.env.local
.env*.local
!.env.example

# ── Flight output ─────────────────────────────────────────
# Flight logs are data, not source. Back them up deliberately;
# do not let them bloat the repo.
organized_flights/
mission_paths/
*.csv
!tests/**/*.csv

# ── OS ────────────────────────────────────────────────────
.DS_Store

# ── Supabase local ────────────────────────────────────────
backend/supabase/.branches/
backend/supabase/.temp/
.vercel
.env*

# The AI deck firmware binary is fetched, not committed.
aideck_gap8_*.bin
