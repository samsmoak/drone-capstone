#!/usr/bin/env bash
#
# Run the flight agent's CLI without activating anything.
#
#   ./cropwatcher check
#   ./cropwatcher geometry --distance 1.0
#
# `source .venv/bin/activate` only ever did one thing: put the venv's bin
# directory on PATH so `cropwatcher` resolved to a command. Calling the
# executable by its path does the same job and cannot be forgotten, left
# active in the wrong shell, or lost by opening a new tab.
#
# Nothing else in this repo needs the venv activated — `pnpm tauri build`
# reaches into it by path too (backend/agent/packaging/build_sidecar.sh).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HERE/backend/agent/.venv"

# A Windows venv puts executables in Scripts/ and suffixes them, same as the
# sidecar build script has to handle.
if [[ -x "$VENV/Scripts/cropwatcher.exe" ]]; then
  exec "$VENV/Scripts/cropwatcher.exe" "$@"
fi

if [[ ! -x "$VENV/bin/cropwatcher" ]]; then
  echo "The agent's virtualenv is not set up at:" >&2
  echo "  $VENV" >&2
  echo >&2
  echo "Create it with:" >&2
  echo "  cd backend/agent && python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
  exit 1
fi

exec "$VENV/bin/cropwatcher" "$@"
