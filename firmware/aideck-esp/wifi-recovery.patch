+/* DroneDeck (wifi-recovery.patch): the station and access-point interfaces,
+ * created ONCE. Stock code created one on every connect request, and a second
+ * creation fails an assert and reboots the ESP32 — which is why a network
+ * could be applied only once per power-on, and the only way to make the deck
+ * rejoin, or even say its address again, was to restart the whole drone. */
+static esp_netif_t* sta_netif = NULL;
+static esp_netif_t* ap_netif = NULL;
+/* Why the station last dropped off (wifi_err_reason_t), 0 = never. */
+static uint8_t last_disconnect_reason = 0;
+
+/* Ask for a (re)connect without aborting when one is already under way: the
+ * stock ESP_ERROR_CHECK here rebooted the chip on a harmless "busy". */
+static void sta_connect(void)
+{
+  esp_err_t err = esp_wifi_connect();
+  if (err != ESP_OK) {
+    ESP_LOGW(TAG, "connect not started: %s", esp_err_to_name(err));
+  }
+}
