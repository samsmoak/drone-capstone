@@ -255,10 +255,28 @@ static void wifi_ctrl(void* _param) {
   }
 }
 
+/* CropWatcher patch (firmware/aideck-esp): close each client ONCE.
+ *
+ * The sending task (on a send error) and the receiving task (on a 0-byte
+ * read) can both close the same connection. Each close set
+ * WIFI_SOCKET_DISCONNECTED, and the second, stale bit made the NEXT client
+ * "disconnect" the instant it was accepted — then that client's own close left
+ * a stale bit for the one after, for ever. The GAP8 was told 1 then 0 on every
+ * connection and never streamed again until the deck was power-cycled.
+ * Measured 2026-09-24: "Connection accepted / Client connected / Client
+ * disconnected" in the same millisecond, on every attempt. */
+static portMUX_TYPE clientLock = portMUX_INITIALIZER_UNLOCKED;
+
 static void close_client_socket()
 {
-    close(clientConnection);
+    taskENTER_CRITICAL(&clientLock);
+    int fd = clientConnection;
     clientConnection = NO_CONNECTION;
+    taskEXIT_CRITICAL(&clientLock);
+    if (fd == NO_CONNECTION) {
+        return;                      /* already closed by the other task */
+    }
+    close(fd);
     xEventGroupSetBits(s_wifi_event_group, WIFI_SOCKET_DISCONNECTED);
 }
 
@@ -329,6 +347,9 @@ static void wifi_task(void *pvParameters) {
   xEventGroupSetBits(startUpEventGroup, START_UP_MAIN_TASK);
   while (1) {
     //blink_period_ms = 500;
+    /* CropWatcher patch: a disconnect belongs to the client it happened to.
+     * Clear any bit left over before accepting the next one. */
+    xEventGroupClearBits(s_wifi_event_group, WIFI_SOCKET_DISCONNECTED);
     wifi_wait_for_socket_connected();
     ESP_LOGI(TAG, "Client connected");
 
