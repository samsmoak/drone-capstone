diff --git a/main/wifi.c b/main/wifi.c
index e5b79c0..8ea733a 100644
--- a/main/wifi.c
+++ b/main/wifi.c
@@ -208,6 +208,10 @@ static void wifi_init_sta(const char * ssid, const char * key)
   ESP_ERROR_CHECK(esp_wifi_set_storage(WIFI_STORAGE_RAM));
   ESP_ERROR_CHECK(esp_wifi_set_config(ESP_IF_WIFI_STA, &wifi_config) );
   ESP_ERROR_CHECK(esp_wifi_start() );
+  // DroneDeck: keep the radio awake. A station defaults to modem sleep
+  // (WIFI_PS_MIN_MODEM), which parks it between beacons — the laptop's ACKs
+  // then wait for it to wake, which throttles a stream of 79 KB frames.
+  ESP_ERROR_CHECK(esp_wifi_set_ps(WIFI_PS_NONE));
 
   ESP_LOGI(TAG, "wifi_init_sta finished.");
 
@@ -319,6 +323,10 @@ void wifi_wait_for_socket_connected() {
     ESP_LOGE(TAG, "Unable to accept connection: errno %d", errno);
   } else {
      ESP_LOGI(TAG, "Connection accepted");
+     // DroneDeck: each CPX packet is its own send() of ~1 KB. With Nagle on,
+     // a frame's last partial segment waits for the laptop's delayed ACK.
+     int nodelay = 1;
+     setsockopt(clientConnection, IPPROTO_TCP, TCP_NODELAY, &nodelay, sizeof(nodelay));
   }
 }
 
