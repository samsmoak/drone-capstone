 /* Why the station last dropped off (wifi_err_reason_t), 0 = never. */
 static uint8_t last_disconnect_reason = 0;
 
+/* DroneDeck (wifi-link.patch): hold the link at a weak signal. The lab
+ * measured the deck at -86 dBm (2026-10-24), and three stock settings work
+ * against a link that weak:
+ *  - 40 MHz channels, ESP-IDF's default for station and access point whenever
+ *    the other side offers them: twice the noise of 20 MHz, so about 3 dB less
+ *    sensitivity, and the first thing a busy 2.4 GHz band breaks. 20 MHz is
+ *    set BEFORE start, so it is what the join negotiates.
+ *  - the transmit ceiling is left to the PHY data; it is set to the ESP32's
+ *    maximum explicitly, and read back into the log.
+ *  - a station drops the network after 6 s without a beacon. A drone turning
+ *    its antenna away fades for seconds; 15 s rides that out, and a real loss
+ *    still rejoins by itself (WIFI_EVENT_STA_DISCONNECTED -> sta_connect).
+ * The rate is NOT fixed. Rate control already falls back to 11b 1 Mbps, the
+ * most sensitive rate, when frames fail (11b stays in the default protocol
+ * set); a fixed rate is refused while TX AMPDU is on, and would only take the
+ * fast rates away when the signal is good. */
+#define LINK_MAX_TX_POWER   80   /* 0.25 dBm steps: 20 dBm, the ESP32's ceiling */
+#define LINK_BEACON_TIMEOUT 15   /* seconds without a beacon before dropping (stock 6) */
+
+static void link_before_start(wifi_interface_t ifx)
+{
+  esp_err_t err = esp_wifi_set_bandwidth(ifx, WIFI_BW_HT20);
+  if (err != ESP_OK) {
+    ESP_LOGW(TAG, "20 MHz not set: %s", esp_err_to_name(err));
+  }
+}
+
+/* One line the ground reads (camera/wifi.py _LINK): what the radio is really
+ * set to, each value read back, and whether a brownout has cut its power.
+ * After a brownout reset ESP-IDF runs the PHY at its lowest power (13 dBm) for
+ * the whole boot (CONFIG_ESP32_REDUCE_PHY_TX_POWER, Bitcraze's setting, kept:
+ * full power right after a brownout can brown it out again); the maximum set
+ * below cannot lift that. Only a power-off clears it. */
+static void link_log(void)
+{
+  wifi_mode_t mode = WIFI_MODE_NULL;
+  esp_wifi_get_mode(&mode);
+  wifi_interface_t ifx = (mode == WIFI_MODE_AP) ? WIFI_IF_AP : WIFI_IF_STA;
+  wifi_bandwidth_t bw = 0;
+  int8_t power = -1;
+  uint16_t timeout = 0;
+  if (esp_wifi_get_bandwidth(ifx, &bw) != ESP_OK) bw = 0;
+  if (esp_wifi_get_max_tx_power(&power) != ESP_OK) power = -1;
+  if (ifx != WIFI_IF_STA || esp_wifi_get_inactive_time(WIFI_IF_STA, &timeout) != ESP_OK) timeout = 0;
+  ESP_LOGI(TAG, "link: %d MHz, power %d, beacon timeout %u s, brownout %d",
+           bw == WIFI_BW_HT20 ? 20 : bw == WIFI_BW_HT40 ? 40 : 0, power, timeout,
+           esp_reset_reason() == ESP_RST_BROWNOUT);
+}
+
+static void link_after_start(wifi_interface_t ifx)
+{
+  esp_err_t err = esp_wifi_set_max_tx_power(LINK_MAX_TX_POWER);
+  if (err != ESP_OK) {
+    ESP_LOGW(TAG, "transmit power not set: %s", esp_err_to_name(err));
+  }
+  if (ifx == WIFI_IF_STA) {
+    err = esp_wifi_set_inactive_time(WIFI_IF_STA, LINK_BEACON_TIMEOUT);
+    if (err != ESP_OK) {
+      ESP_LOGW(TAG, "beacon timeout not set: %s", esp_err_to_name(err));
+    }
+  }
+  link_log();
+}
+
