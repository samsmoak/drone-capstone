# CropWatcher agent configuration.
# Copy to .env and fill in. Never commit .env.

# ─── Supabase ────────────────────────────────────────────────
# Project Settings → API. The anon key is designed to be public; it is safe
# inside the desktop installer because RLS decides what it can actually do.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ─── Operator sign-in ────────────────────────────────────────
# The agent signs in as a real operator account and acts under RLS. It does
# NOT use the service-role key: that would bypass every policy, and since this
# agent ships inside a downloadable installer, embedding one would hand full
# database access to everyone who installs it.
#
# The account needs role='operator' in public.profiles. A 'viewer' can read
# but will be refused when it tries to claim a mission.
CROPWATCHER_EMAIL=operator@cropwatcher.local
CROPWATCHER_PASSWORD=cropwatcher

# ─── Optional ────────────────────────────────────────────────
# Identifies which laptop claimed a mission. Defaults to the machine name.
# CROPWATCHER_AGENT_ID=greenhouse-laptop-1

# Radio URI. Override only if the drone was reconfigured off the default.
# CROPWATCHER_URI=radio://0/80/2M
